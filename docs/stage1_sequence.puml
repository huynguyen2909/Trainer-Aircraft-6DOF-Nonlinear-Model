@startuml
title One RK4 Step - TrainerAircraft Stage 1 Contract

actor Simulation
participant RK4Integrator as rk4
participant TrainerAircraftModel as trainer_aircraft
participant "ILoadComponent[*]" as components
participant LoadAccumulator as accumulator
participant RigidBody6DOF as rigidbody

Simulation -> rk4 : step(t, dt, state, derivativeFunction)
activate rk4

loop k1, k2, k3, k4
    rk4 -> trainer_aircraft : evaluateDerivative(stageTime, stageState, controls, environment)
    activate trainer_aircraft
    trainer_aircraft -> trainer_aircraft : calculateFlightCondition()
    create accumulator
    trainer_aircraft -> accumulator : construct fresh accumulator

    loop every registered component
        trainer_aircraft -> components : computeLoad(EvaluationContext)
        components --> trainer_aircraft : BodyLoad(F_body, M_CG_body)
        trainer_aircraft -> accumulator : add(BodyLoad)
    end

    trainer_aircraft -> accumulator : total()
    accumulator --> trainer_aircraft : totalComponentLoad
    trainer_aircraft -> rigidbody : evaluate(stageState, totalLoad, gravityNed)
    rigidbody --> trainer_aircraft : StateDerivative
    trainer_aircraft --> rk4 : StateDerivative
    deactivate trainer_aircraft
end

rk4 -> rk4 : weighted RK4 sum\nnormalize q_nb
rk4 --> Simulation : state(t + dt)
deactivate rk4
@enduml

